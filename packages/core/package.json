{
  "name": "@contextdeck/core",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Core Git-backed board store, schemas, drift/catch-up engine, Context Pack builder, and worker config for ContextDeck.",
  "keywords": [
    "contextdeck",
    "mcp",
    "ai-agents",
    "shared-context",
    "local-first"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stress": "vitest run --project stress"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "js-yaml": "^4.1.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
