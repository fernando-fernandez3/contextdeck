{
  "name": "@contextdeck/server",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Local Hono REST/SSE API, Streamable HTTP and stdio MCP server, and bundled Web UI server for ContextDeck.",
  "keywords": [
    "contextdeck",
    "mcp",
    "hono",
    "ai-agents",
    "local-first"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "web-dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build && node ./scripts/copy-web-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@contextdeck/core": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "busboy": "^1.6.0",
    "hono": "^4.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
