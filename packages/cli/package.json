{
  "name": "@contextdeck/cli",
  "version": "0.2.0",
  "license": "MIT",
  "description": "ContextDeck CLI (`cdeck` / `contextdeck`) for local shared context boards, harness setup/hooks, MCP stdio, and refresh workers.",
  "keywords": [
    "contextdeck",
    "cli",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "ai-agents"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "contextdeck": "./dist/index.js",
    "cdeck": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"if (process.platform !== 'win32') require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@contextdeck/core": "workspace:*",
    "@contextdeck/server": "workspace:*",
    "commander": "^14.0.0",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
